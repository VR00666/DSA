#include <stdio.h>
#include <stdlib.h>

struct Node{
    int data;
    struct Node *link;
};

struct Node *top1=NULL;
struct Node *top2=NULL;

//Function Prototypes
void push1(int);
void push2(int);
int pop1();
int pop2();
void enqueue(int);
void dequeue();
void peek();
void display();
int isEmpty();

int main(){

    int choice,n;

    do{
        printf("\n--- Queue using Stacks Menu ---\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Peek\n");
        printf("4. Display\n");
        printf("5. Check Empty\n");
        printf("6. Exit\n");

        printf("Enter your choice: ");
        scanf("%d",&choice);

        switch(choice){

            case 1:
                printf("Enter the element: ");
                scanf("%d",&n);
                enqueue(n);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                peek();
                break;

            case 4:
                display();
                break;

            case 5:
                if(isEmpty())
                    printf("Queue is empty\n");
                else
                    printf("Queue is not empty\n");
                break;

            case 6:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    }while(choice!=6);

    return 0;
}


//To check whether the queue is empty
int isEmpty(){

    return(top1==NULL && top2==NULL);
}


//To insert an element into Stack 1
void push1(int n){

    struct Node *newNode;

    newNode=(struct Node*)malloc(sizeof(struct Node));

    if(newNode==NULL){
        printf("Memory Allocation Failed\n");
        return;
    }

    newNode->data=n;
    newNode->link=top1;
    top1=newNode;
}


//To insert an element into Stack 2
void push2(int n){

    struct Node *newNode;

    newNode=(struct Node*)malloc(sizeof(struct Node));

    if(newNode==NULL){
        printf("Memory Allocation Failed\n");
        return;
    }

    newNode->data=n;
    newNode->link=top2;
    top2=newNode;
}


//To remove an element from Stack 1
int pop1(){

    struct Node *temp;
    int item;

    if(top1==NULL)
        return -1;

    temp=top1;
    item=temp->data;
    top1=top1->link;

    free(temp);

    return item;
}


//To remove an element from Stack 2
int pop2(){

    struct Node *temp;
    int item;

    if(top2==NULL)
        return -1;

    temp=top2;
    item=temp->data;
    top2=top2->link;

    free(temp);

    return item;
}


//To insert an element into the queue
void enqueue(int n){

    push1(n);
}


//To delete an element from the queue
void dequeue(){

    int item;

    if(top2==NULL){

        while(top1!=NULL){

            item=pop1();
            push2(item);
        }
    }

    if(top2==NULL){
        printf("Queue Underflow\n");
        return;
    }

    item=pop2();

    printf("Deleted element is %d\n",item);
}


//To return the front element of the queue
void peek(){

    int item;

    if(top2==NULL){

        while(top1!=NULL){

            item=pop1();
            push2(item);
        }
    }

    if(top2==NULL){
        printf("Queue is empty\n");
        return;
    }

    printf("The front element is %d\n",top2->data);
}


//To display the elements of the queue
void display(){

    struct Node *temp;
    int item;

    if(isEmpty()){
        printf("Queue is empty\n");
        return;
    }

    if(top2==NULL){

        while(top1!=NULL){

            item=pop1();
            push2(item);
        }
    }

    printf("The queue elements are\n");

    temp=top2;

    while(temp!=NULL){

        printf("%d\n",temp->data);
        temp=temp->link;
    }

    printf("\n");
}
