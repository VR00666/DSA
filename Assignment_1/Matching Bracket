#include <stdio.h>

#define max 100

char stack[max];
int top=-1;

//Function Prototypes
int isEmpty();
int isFull();
void push(char ch);
char pop();
int isMatching(char open,char close);

int main(){

    char exp[100];

    printf("Enter the expression: ");
    fgets(exp,sizeof(exp),stdin);

    for(int i=0;exp[i]!='\0';i++){

        if(exp[i]=='(' || exp[i]=='{' || exp[i]=='['){
            push(exp[i]);
        }

        else if(exp[i]==')' || exp[i]=='}' || exp[i]==']'){

            if(isEmpty()){
                printf("Brackets are not balanced.\n");
                return 0;
            }

            char ch=pop();

            if(!isMatching(ch,exp[i])){
                printf("Brackets are not balanced.\n");
                return 0;
            }
        }
    }

    if(isEmpty())
        printf("Brackets are balanced.\n");
    else
        printf("Brackets are not balanced.\n");

    return 0;
}

//Function Definitions

int isEmpty(){
    return(top==-1);
}

int isFull(){
    return(top==max-1);
}

void push(char ch){
    if(isFull()){
        printf("Stack Overflow\n");
        return;
    }

    stack[++top]=ch;
}

char pop(){
    if(isEmpty())
        return '\0';

    return stack[top--];
}

int isMatching(char open,char close){

    if(open=='(' && close==')')
        return 1;

    if(open=='{' && close=='}')
        return 1;

    if(open=='[' && close==']')
        return 1;

    return 0;
}
