#include <stdio.h>
#include <stdlib.h>

struct Node{
    int data;
    struct Node *next;
};

struct Node *head=NULL;

//Function Prototypes
void insertBeginning(int);
void insertEnd(int);
void deleteBeginning();
void deleteEnd();
void display();
void deletePosition(int pos);
void insertPosition(int data,int pos);



int main(){

    insertBeginning(20);
    insertBeginning(10);
    insertEnd(30);
    insertEnd(40);

    display();

    deleteBeginning();
    display();

    deleteEnd();
    display();

    return 0;
}

//Function Definitions

void insertBeginning(int data){

    struct Node *newNode;

    newNode = (struct Node*)malloc(sizeof(struct Node));

    newNode->data = data;
    newNode->next = NULL;

    // Empty List
    if(head == NULL){
        head = newNode;
        return;
    }

    // List already contains nodes
    newNode->next = head;
    head = newNode;
}

void insertEnd(int data){

    struct Node *newNode,*temp;

    newNode=(struct Node*)malloc(sizeof(struct Node));

    newNode->data=data;
    newNode->next=NULL;

    if(head==NULL){
        head=newNode;
        return;
    }

    temp=head;

    while(temp->next!=NULL){
        temp=temp->next;
    }

    temp->next=newNode;
}

void deleteBeginning(){

    struct Node *temp;

    if(head==NULL){
        printf("Linked List is Empty\n");
        return;
    }

    temp=head;

    //Only one node
    if(head->next==NULL){
        free(temp);
        head=NULL;
        return;
    }

    head=head->next;
    free(temp);
}                                                                                               

void insertPosition(int data,int pos){

    struct Node *newNode,*temp;
    int count=0,i;

    //Count the number of nodes
    temp=head;

    while(temp!=NULL){
        count++;
        temp=temp->next;
    }

    //Check whether the position is valid
    if(pos<1 || pos>count+1){
        printf("Invalid Position\n");
        return;
    }

    //Create a new node
    newNode=(struct Node*)malloc(sizeof(struct Node));

    newNode->data=data;
    newNode->next=NULL;

    //Insert at the beginning
    if(pos==1){
        newNode->next=head;
        head=newNode;
        return;
    }

    //Move temp to the node before the required position
    temp=head;

    for(i=1;i<pos-1;i++){
        temp=temp->next;
    }

    //Insert the node
    newNode->next=temp->next;
    temp->next=newNode;
}



void deleteEnd(){

    struct Node *temp,*prev;

    if(head==NULL){
        printf("Linked List is Empty\n");
        return;
    }

    temp=head;

    if(temp->next==NULL){
        free(temp);
        head=NULL;
        return;
    }

    while(temp->next!=NULL){
        prev=temp;
        temp=temp->next;
    }

    prev->next=NULL;
    free(temp);
 }    
 void deletePosition(int pos){

    struct Node *temp,*prev;
    int i;

    if(head==NULL){
        printf("Linked List is Empty\n");
        return;
    }

    temp=head;

    //Delete the first node
    if(pos==1){
        head=head->next;
        free(temp);
        return;
    }

    //Move temp to the required position
    for(i=1;i<pos && temp!=NULL;i++){
        prev=temp;
        temp=temp->next;
    }

    //Check whether the position is valid
    if(temp==NULL){
        printf("Invalid Position\n");
        return;
    }

    //Delete the node
    prev->next=temp->next;
    free(temp);
}

void display(){

    struct Node *temp;

    if(head==NULL){
        printf("Linked List is Empty\n");
        return;
    }

    temp=head;

    printf("Linked List: ");

    while(temp!=NULL){
        printf("%d ",temp->data);
        temp=temp->next;
    }

    printf("\n");
}
