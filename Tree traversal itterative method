#include <stdio.h>
#include <stdlib.h>

#define MAX 100

struct node{
    int data;
    struct node *left;
    struct node *right;
};

struct node* stack[MAX];
int top=-1;

//Function Prototypes
struct node* createnode(int);
struct node* search(struct node*,int);
struct node* insert(struct node*,int,int,char);
void push(struct node*);
struct node* pop();
void preorder(struct node*);
void inorder(struct node*);
void postorder(struct node*);

int main(){

    struct node *root=NULL;
    int choice,data,parent;
    char side;

    do{
        printf("\n--- Binary Tree Menu ---\n");
        printf("1. Insert Node\n");
        printf("2. Preorder Traversal\n");
        printf("3. Inorder Traversal\n");
        printf("4. Postorder Traversal\n");
        printf("5. Display All Traversals\n");
        printf("6. Exit\n");

        printf("Enter your choice: ");
        scanf("%d",&choice);

        switch(choice){

            case 1:
                printf("Enter the data: ");
                scanf("%d",&data);

                if(root==NULL){

                    root=createnode(data);
                    printf("Root node inserted successfully\n");
                }
                else{

                    printf("Enter the parent node: ");
                    scanf("%d",&parent);

                    printf("Enter L for left child or R for right child: ");
                    scanf(" %c",&side);

                    root=insert(root,data,parent,side);
                }

                break;

            case 2:
                printf("Preorder traversal: ");
                preorder(root);
                printf("\n");
                break;

            case 3:
                printf("Inorder traversal: ");
                inorder(root);
                printf("\n");
                break;

            case 4:
                printf("Postorder traversal: ");
                postorder(root);
                printf("\n");
                break;

            case 5:
                printf("Preorder traversal: ");
                preorder(root);

                printf("\nInorder traversal: ");
                inorder(root);

                printf("\nPostorder traversal: ");
                postorder(root);

                printf("\n");
                break;

            case 6:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    }while(choice!=6);

    return 0;
}


//To create a new node
struct node* createnode(int n){

    struct node *newnode;

    newnode=(struct node*)malloc(sizeof(struct node));

    newnode->data=n;
    newnode->left=NULL;
    newnode->right=NULL;

    return newnode;
}


//To search for a node
struct node* search(struct node *root,int data){

    struct node *temp;

    if(root==NULL)
        return NULL;

    if(root->data==data)
        return root;

    temp=search(root->left,data);

    if(temp!=NULL)
        return temp;

    return search(root->right,data);
}


//To insert a node
struct node* insert(struct node *root,int data,int parent,char side){

    struct node *parentNode;
    struct node *newnode;

    parentNode=search(root,parent);

    if(parentNode==NULL){

        printf("Parent node not found\n");
        return root;
    }

    if(side=='L' || side=='l'){

        if(parentNode->left!=NULL){

            printf("Left child already exists\n");
            return root;
        }

        newnode=createnode(data);
        parentNode->left=newnode;

        printf("Node inserted successfully\n");
    }

    else if(side=='R' || side=='r'){

        if(parentNode->right!=NULL){

            printf("Right child already exists\n");
            return root;
        }

        newnode=createnode(data);
        parentNode->right=newnode;

        printf("Node inserted successfully\n");
    }

    else{

        printf("Invalid choice\n");
    }

    return root;
}


//To push a node into the stack
void push(struct node *n){

    if(top==MAX-1)
        return;

    stack[++top]=n;
}


//To pop a node from the stack
struct node* pop(){

    if(top==-1)
        return NULL;

    return stack[top--];
}


//To perform preorder traversal iteratively
void preorder(struct node *root){

    struct node *temp;

    if(root==NULL)
        return;

    top=-1;
    push(root);

    while(top!=-1){

        temp=pop();

        printf("%d ",temp->data);

        if(temp->right!=NULL)
            push(temp->right);

        if(temp->left!=NULL)
            push(temp->left);
    }
}


//To perform inorder traversal iteratively
void inorder(struct node *root){

    struct node *temp=root;

    top=-1;

    while(temp!=NULL || top!=-1){

        while(temp!=NULL){

            push(temp);
            temp=temp->left;
        }

        temp=pop();

        printf("%d ",temp->data);

        temp=temp->right;
    }
}


//To perform postorder traversal iteratively
void postorder(struct node *root){

    struct node *temp;
    struct node *stack2[MAX];
    int top2=-1;

    if(root==NULL)
        return;

    top=-1;
    push(root);

    while(top!=-1){

        temp=pop();

        stack2[++top2]=temp;

        if(temp->left!=NULL)
            push(temp->left);

        if(temp->right!=NULL)
            push(temp->right);
    }

    while(top2!=-1){

        temp=stack2[top2--];

        printf("%d ",temp->data);
    }
}
