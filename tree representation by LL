#include <stdio.h>
#include <stdlib.h>

struct node{
    int data;
    struct node *left;
    struct node *right;
};

struct node *root=NULL;

struct node* createnode(int);
struct node* search(struct node*,int);
void insertleft(struct node*,int);
void insertright(struct node*,int);
void preorder(struct node*);
void inorder(struct node*);
void postorder(struct node*);

int main(){

    int choice,n,parent;
    struct node *temp;

    do{
        printf("\n--- Binary Tree Menu ---\n");
        printf("1. Create Root\n");
        printf("2. Insert Left Child\n");
        printf("3. Insert Right Child\n");
        printf("4. Preorder Traversal\n");
        printf("5. Inorder Traversal\n");
        printf("6. Postorder Traversal\n");
        printf("7. Exit\n");

        printf("Enter your choice: ");
        scanf("%d",&choice);

        switch(choice){

            case 1:
                printf("Enter the root element: ");
                scanf("%d",&n);

                if(root==NULL)
                    root=createnode(n);
                else
                    printf("Root already exists\n");
                break;

            case 2:
                if(root==NULL){
                    printf("Tree is empty\n");
                    break;
                }

                printf("Enter the parent element: ");
                scanf("%d",&parent);

                temp=search(root,parent);

                if(temp!=NULL){
                    printf("Enter the element: ");
                    scanf("%d",&n);
                    insertleft(temp,n);
                }
                else
                    printf("Parent node not found\n");
                break;

            case 3:
                if(root==NULL){
                    printf("Tree is empty\n");
                    break;
                }

                printf("Enter the parent element: ");
                scanf("%d",&parent);

                temp=search(root,parent);

                if(temp!=NULL){
                    printf("Enter the element: ");
                    scanf("%d",&n);
                    insertright(temp,n);
                }
                else
                    printf("Parent node not found\n");
                break;

            case 4:
                printf("Preorder traversal is\n");
                preorder(root);
                printf("\n");
                break;

            case 5:
                printf("Inorder traversal is\n");
                inorder(root);
                printf("\n");
                break;

            case 6:
                printf("Postorder traversal is\n");
                postorder(root);
                printf("\n");
                break;

            case 7:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    }while(choice!=7);

    return 0;
}


//To create a new node
struct node* createnode(int n){

    struct node *newnode;

    newnode=(struct node*)malloc(sizeof(struct node));

    newnode->data=n;
    newnode->left=NULL;
    newnode->right=NULL;

    return newnode;
}


//To search for a node
struct node* search(struct node *root,int key){

    struct node *temp;

    if(root==NULL || root->data==key)
        return root;

    temp=search(root->left,key);

    if(temp!=NULL)
        return temp;

    return search(root->right,key);
}


//To insert the left child
void insertleft(struct node *parent,int n){

    if(parent->left!=NULL){
        printf("Left child already exists\n");
        return;
    }

    parent->left=createnode(n);
}


//To insert the right child
void insertright(struct node *parent,int n){

    if(parent->right!=NULL){
        printf("Right child already exists\n");
        return;
    }

    parent->right=createnode(n);
}


//To perform preorder traversal
void preorder(struct node *root){

    if(root!=NULL){
        printf("%d ",root->data);
        preorder(root->left);
        preorder(root->right);
    }
}


//To perform inorder traversal
void inorder(struct node *root){

    if(root!=NULL){
        inorder(root->left);
        printf("%d ",root->data);
        inorder(root->right);
    }
}


//To perform postorder traversal
void postorder(struct node *root){

    if(root!=NULL){
        postorder(root->left);
        postorder(root->right);
        printf("%d ",root->data);
    }
}
