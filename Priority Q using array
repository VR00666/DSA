#include <stdio.h>

#define max 10

struct queue{
    int data;
    int priority;
};

struct queue pq[max];

int rear=-1;

//Function Prototypes
int isempty();
int isfull();
void enqueue(int,int);
void dequeue();
void peek();
void display();

int main(){

    enqueue(10,3);
    enqueue(20,1);
    enqueue(30,2);

    display();

    dequeue();

    display();

    peek();

    return 0;
}

//Function Definitions

int isempty(){

    return(rear==-1);
}

int isfull(){

    return(rear==max-1);
}

void enqueue(int d,int p){

    if(isfull()){
        printf("Queue Overflow\n");
        return;
    }

    rear++;

    pq[rear].data=d;
    pq[rear].priority=p;
}

void dequeue(){

    int pos=0;
    int i;

    if(isempty()){
        printf("Queue Underflow\n");
        return;
    }

    for(i=0;i<=rear;i++){

        if(pq[i].priority<pq[pos].priority){
            pos=i;
        }
    }

    printf("The deleted element = %d\n",pq[pos].data);

    for(i=pos;i<rear;i++){

        pq[i]=pq[i+1];
    }

    rear--;
}

void peek(){

    int i,pos=0;

    if(isempty()){
        printf("Queue Underflow\n");
        return;
    }

    for(i=0;i<=rear;i++){

        if(pq[i].priority<pq[pos].priority){
            pos=i;
        }
    }

    printf("The highest priority element is %d\n",pq[pos].data);
    printf("The highest priority is %d\n",pq[pos].priority);
}

void display(){

    struct queue temp[max],t;
    int i,j;

    if(isempty()){
        printf("Queue Underflow\n");
        return;
    }

    //Copy the original queue
    for(i=0;i<=rear;i++){

        temp[i]=pq[i];
    }

    //Sort according to priority
    for(i=0;i<rear;i++){

        for(j=i+1;j<=rear;j++){

            if(temp[i].priority>temp[j].priority){

                t=temp[i];
                temp[i]=temp[j];
                temp[j]=t;
            }
        }
    }

    printf("Data\tPriority\n");

    for(i=0;i<=rear;i++){

        printf("%d\t%d\n",temp[i].data,temp[i].priority);
    }
}
