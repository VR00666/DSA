#include <stdio.h>

#define max 2

struct queue{
    int data;
    int priority;
};

struct queue pq[max];

int rear=-1;

//Function Prototypes
int isempty();
int isfull();
void enqueue(int,int);
void dequeue();
void peek();
void display();

int main(){

    int choice,d,p;

    do{

        printf("\n--- Priority Queue Menu ---\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Peek\n");
        printf("4. Display\n");
        printf("5. Check Empty\n");
        printf("6. Check Full\n");
        printf("7. Exit\n");

        printf("Enter your choice: ");
        scanf("%d",&choice);

        switch(choice){

            case 1:
                printf("Enter the data: ");
                scanf("%d",&d);

                printf("Enter the priority: ");
                scanf("%d",&p);

                enqueue(d,p);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                peek();
                break;

            case 4:
                display();
                break;

            case 5:
                if(isempty())
                    printf("Queue is empty\n");
                else
                    printf("Queue is not empty\n");
                break;

            case 6:
                if(isfull())
                    printf("Queue is full\n");
                else
                    printf("Queue is not full\n");
                break;

            case 7:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    }while(choice!=7);

    return 0;
}
//Function Definitions

int isempty(){

    return(rear==-1);
}

int isfull(){

    return(rear==max-1);
}

void enqueue(int d,int p){

    if(isfull()){
        printf("Queue Overflow\n");
        return;
    }

    rear++;

    pq[rear].data=d;
    pq[rear].priority=p;
}

void dequeue(){

    int pos=0;
    int i;

    if(isempty()){
        printf("Queue Underflow\n");
        return;
    }

    for(i=0;i<=rear;i++){

        if(pq[i].priority<pq[pos].priority){
            pos=i;
        }
    }

    printf("The deleted element = %d\n",pq[pos].data);

    for(i=pos;i<rear;i++){

        pq[i]=pq[i+1];
    }

    rear--;
}

void peek(){

    int i,pos=0;

    if(isempty()){
        printf("Queue Underflow\n");
        return;
    }

    for(i=0;i<=rear;i++){

        if(pq[i].priority<pq[pos].priority){
            pos=i;
        }
    }

    printf("The highest priority element is %d\n",pq[pos].data);
    printf("The highest priority is %d\n",pq[pos].priority);
}

void display(){

    struct queue temp[max],t;
    int i,j;

    if(isempty()){
        printf("Queue Underflow\n");
        return;
    }

    //Copy the original queue
    for(i=0;i<=rear;i++){

        temp[i]=pq[i];
    }

    //Sort according to priority
    for(i=0;i<rear;i++){

        for(j=i+1;j<=rear;j++){

            if(temp[i].priority>temp[j].priority){

                t=temp[i];
                temp[i]=temp[j];
                temp[j]=t;
            }
        }
    }

    printf("Data\tPriority\n");

    for(i=0;i<=rear;i++){

        printf("%d\t%d\n",temp[i].data,temp[i].priority);
    }
}
