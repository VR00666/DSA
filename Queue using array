#include <stdio.h> 
#define MAX 100 
int queue[MAX]; 
int isFull(); 
int isempty(); 
void enqueue(int n); 
int dequeue(); 
int peek(); 
int size(); 
void display(); 
int front=-1,rear=-1; 
 
 
int main(){ 
       enqueue(10); 
       enqueue(20); 
       enqueue(30); 
       display(); 
       printf("deleted element is %d\n",dequeue()); 
       display(); 
       printf("the front element is %d\n",peek()); 
       printf("the queue size is %d/n",size()); 
 
 
} 
int isempty(){ 
           return(front==-1);   
 
              } 
int isFull(){ 
           return(rear==MAX-1); 
           
 
            } 
int peek(){ 
          if(isempty()){ 
                   printf("stack is empty\n");                    
                   return -1;    
                         } 
          return queue[front]; 
         } 
int size(){ 
       if(isempty()){ 
                   printf("stack is empty\n"); 
                   return -1; 
                     }  
       return(rear-front+1); 
           } 
void enqueue(int n){ 
       if(isFull()){ 
                  printf("Stack overflow  condition\n"); 
                  return ;      
                    } 
        if(isempty()){ 
                   front=0; 
                      } 
        queue[++rear]=n; 
                    } 
int dequeue(){ 
      if(isempty()){ 
      printf("stack underflow\n"); 
      return -1; 
                    } 
      int item=queue[front]; 
      if(front==rear){ 
              front=rear=-1;    
                      } 
      else{ 
           front++;         
           } 
      return item; 
              } 
 
void display(){ 
     if(isempty()){ 
           printf("the stack is empty\n"); 
           return; 
                  }  
      printf("the queue elements are\n"); 
      for(int i=front;i<=rear;i++){ 
            printf("%d ",queue[i]); 
                                  } 
     printf("\n"); 
               } 
 
 
