#include <stdio.h> 
#define Max 2 
int Dqueue[Max]; 
int front=-1,rear=-1; 
 
int isempty(); 
int isfull(); 
void enqueuefront(int); 
void enqueuerear(int); 
int dequeuefront(); 
int dequeuerear(); 
int peekfront(); 
int peekrear(); 
void display(); 
int size(); 
 
 
int main(){
    int choice,n;

    do{
        printf("\n--- Double Ended Queue Menu ---\n");
        printf("1. Enqueue at Front\n");
        printf("2. Enqueue at Rear\n");
        printf("3. Dequeue from Front\n");
        printf("4. Dequeue from Rear\n");
        printf("5. Peek Front\n");
        printf("6. Peek Rear\n");
        printf("7. Display\n");
        printf("8. Size\n");
        printf("9. Check Empty\n");
        printf("10. Check Full\n");
        printf("11. Exit\n");

        printf("Enter your choice: ");
        scanf("%d",&choice);

        switch(choice){

            case 1:
                printf("Enter the element: ");
                scanf("%d",&n);
                enqueuefront(n);
                break;

            case 2:
                printf("Enter the element: ");
                scanf("%d",&n);
                enqueuerear(n);
                break;

            case 3:
                n=dequeuefront();
                if(n!=-1)
                    printf("Deleted element from front is %d\n",n);
                break;

            case 4:
                n=dequeuerear();
                if(n!=-1)
                    printf("Deleted element from rear is %d\n",n);
                break;

            case 5:
                n=peekfront();
                if(n!=-1)
                    printf("The front element is %d\n",n);
                break;

            case 6:
                n=peekrear();
                if(n!=-1)
                    printf("The rear element is %d\n",n);
                break;

            case 7:
                display();
                break;

            case 8:
                n=size();
                if(n!=-1)
                    printf("The queue size is %d\n",n);
                break;

            case 9:
                if(isempty())
                    printf("Queue is empty\n");
                else
                    printf("Queue is not empty\n");
                break;

            case 10:
                if(isfull())
                    printf("Queue is full\n");
                else
                    printf("Queue is not full\n");
                break;

            case 11:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    }while(choice!=11);

    return 0;
}
int isempty(){ 
             return(front==-1);      
 
} 
int isfull(){ 
            return(front==0 && rear==Max-1 || front==rear+1); 
} 
 
//To return the first element in the circular queue 
int peekfront(){ 
          if(isempty()){ 
                   printf("queue is empty\n");                    
                   return -1;    
                         } 
          return Dqueue[front]; 
         } 
int peekrear(){ 
          if(isempty()){ 
                   printf("queue is empty \n");     
                        } 
          return Dqueue[rear]; 
 
 
                        } 
//To enter an element to the queue 
void enqueuefront(int n){ 
       if(isfull()){ 
                  printf("queue overflow  condition\n"); 
                  return ;      
                    } 
        if(isempty()){ 
                   front=rear=0; 
                      } 
       else if(front==0){ 
                   front=Max-1; 
                       } 
       else{   
                    front=front-1; 
           } 
        Dqueue[front]=n; 
                    } 
 void enqueuerear(int n){ 
        if(isfull()){ 
                   printf("queue overflow  condition\n"); 
                   return ; 
                     } 
         if(isempty()){ 
                    front=rear=0; 
                       } 
          else if(rear==Max-1){ 
                    rear=0; 
                      } 
 
        else{ 
         rear=rear+1; 
            } 
  
         Dqueue[rear]=n; 
                     } 
 
 
//To remove an elemnet from the queue 
int dequeuefront(){ 
      if(isempty()){ 
      printf("stack underflow\n"); 
      return -1; 
                    } 
      int item=Dqueue[front]; 
      if(front==rear){ 
              front=rear=-1;    
       
                } 
      else if(front==Max-1){ 
              front=0; 
} 
      else{ 
           front=front+1;         
           } 
      return item; 
              } 
 
int dequeuerear(){ 
      if(isempty()){ 
      printf("stack underflow\n"); 
      return -1; 
                    } 
      int item=Dqueue[rear]; 
      if(front==rear){ 
              front=rear=-1;    
                      } 
      else if(rear==0){ 
              rear=Max-1; 
} 
      else{ 
             rear=rear-1;         
           } 
      return item; 
              } 
 
//To return the size of queue 
int size(){ 
       if(isempty()){ 
                   printf("queue is empty\n"); 
                   return -1; 
                     } 
       if(rear>front){  
                   return(rear-front+1);} 
       return (Max-front+rear+1); 
           } 
 
 
//To display the elements of the queue 
void display(){ 
     if(isempty()){ 
           printf("the stack is empty\n"); 
           return; 
                  }  
      printf("the queue elements are\n"); 
      int i=front; 
      while(1){ 
               printf("%d \n",Dqueue[i]); 
               if(i==rear) 
                       break; 
               i=(i+1)%Max; 
                } 
     printf("\n"); 
} 
 
 
