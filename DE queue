#include  
#define MAX 3
int queue[MAX]; 
int front=-1; 
int rear=-1; 
int isFull(); 
int isempty(); 
void enqueue(int n); 
int dequeue(); 
int peek(); 
int size(); 
void display(); 
 
int main(){

    int choice,n;

    do{
        printf("\n--- Circular Queue Menu ---\n");
        printf("1. Enqueue\n");
        printf("2. Dequeue\n");
        printf("3. Peek\n");
        printf("4. Display\n");
        printf("5. Size\n");
        printf("6. Check Empty\n");
        printf("7. Check Full\n");
        printf("8. Exit\n");

        printf("Enter your choice: ");
        scanf("%d",&choice);

        switch(choice){

            case 1:
                printf("Enter the element: ");
                scanf("%d",&n);
                enqueue(n);
                break;

            case 2:
                n=dequeue();
                if(n!=-1)
                    printf("Deleted element is %d\n",n);
                break;

            case 3:
                n=peek();
                if(n!=-1)
                    printf("The front element is %d\n",n);
                break;

            case 4:
                display();
                break;

            case 5:
                n=size();
                if(n!=-1)
                    printf("The queue size is %d\n",n);
                break;

            case 6:
                if(isempty())
                    printf("Queue is empty\n");
                else
                    printf("Queue is not empty\n");
                break;

            case 7:
                if(isFull())
                    printf("Queue is full\n");
                else
                    printf("Queue is not full\n");
                break;

            case 8:
                printf("Exiting...\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    }while(choice!=8);

    return 0;
}
//To check whether the queue is empty 
int isempty(){ 
           return(front==-1);   
 
               } 
//To check whether the queue is full 
int isFull()
{
    if ((front == 0 && rear == MAX - 1) || (rear + 1 == front))
        return 1;

    return 0;
}

//To return the first element in the circular queue 
int peek(){ 
          if(isempty()){ 
                   printf("queue is empty\n");                    
                   return -1;    
                          } 
          return queue[front]; 
         } 
//To return the size of queue 
int size(){ 
       if(isempty()){ 
                   printf("queue is empty\n"); 
                   return -1; 
                     } 
       if(rear>front){  
                   return(rear-front+1);} 
       return (MAX-front+rear+1); 
           } 
//To enter an element to the queue 
void enqueue(int n){ 
       if(isFull()){ 
                  printf("queue overflow  condition\n"); 
                  return ;      
                    } 
        if(isempty()){ 
                   front=rear=0; 
                      } 
       else{   
        rear=(rear+1)%MAX;} 
        queue[rear]=n; 
                    } 
//To remove an elemnet from the queue 
int dequeue(){ 
      if(isempty()){ 
      printf("stack underflow\n"); 
      return -1; 
                    } 
      int item=queue[front]; 
      if(front==rear){ 
              front=rear=-1;    
                      } 
      else{ 
           front=(front+1)%MAX;         
           } 
      return item; 
              } 
 
//To display the elements of the queue 
void display(){ 
     if(isempty()){ 
           printf("the stack is empty\n"); 
           return; 
                  }  
      printf("the queue elements are\n"); 
      int i=front; 
      while(1){ 
               printf("%d \n",queue[i]); 
               if(i==rear) 
                       break; 
               i=(i+1)%MAX; 
                } 
     printf("\n"); 
}
