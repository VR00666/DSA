#include <stdio.h>
#include <stdlib.h>

struct Node{
    float coeff;
    int expo;
    struct Node *link;
};

void insert(struct Node **head,float coeff,int expo);
struct Node* create();
struct Node* multiplyPolynomial(struct Node*,struct Node*);
void display(struct Node*);

int main(){
    struct Node *poly1,*poly2,*result;

    printf("Enter first polynomial\n");
    poly1=create();

    printf("Enter second polynomial\n");
    poly2=create();

    printf("\nFirst polynomial: ");
    display(poly1);

    printf("Second polynomial: ");
    display(poly2);

    result=multiplyPolynomial(poly1,poly2);

    printf("Resultant polynomial: ");
    display(result);

    return 0;
}

struct Node* create(){
    struct Node *head=NULL;
    int n,i,expo;
    float coeff;

    printf("Enter number of terms: ");
    scanf("%d",&n);

    for(i=0;i<n;i++){
        printf("Enter coefficient: ");
        scanf("%f",&coeff);

        printf("Enter exponent: ");
        scanf("%d",&expo);

        insert(&head,coeff,expo);
    }

    return head;
}

void insert(struct Node **head,float coeff,int expo){
    struct Node *newP,*temp;

    if(coeff==0)
        return;

    newP=(struct Node*)malloc(sizeof(struct Node));

    if(newP==NULL){
        printf("Memory Allocation Failed\n");
        return;
    }

    newP->coeff=coeff;
    newP->expo=expo;
    newP->link=NULL;

    if(*head==NULL){
        *head=newP;
        return;
    }

    if(expo>(*head)->expo){
        newP->link=*head;
        *head=newP;
        return;
    }

    if(expo==(*head)->expo){
        (*head)->coeff+=coeff;
        free(newP);
        return;
    }

    temp=*head;

    while(temp->link!=NULL && temp->link->expo>expo)
        temp=temp->link;

    if(temp->link!=NULL && temp->link->expo==expo){
        temp->link->coeff+=coeff;
        free(newP);
        return;
    }

    newP->link=temp->link;
    temp->link=newP;
}

struct Node* multiplyPolynomial(struct Node *poly1,struct Node *poly2){
    struct Node *result=NULL;
    struct Node *p,*q;

    for(p=poly1;p!=NULL;p=p->link){
        for(q=poly2;q!=NULL;q=q->link){
            insert(&result,
                   p->coeff*q->coeff,
                   p->expo+q->expo);
        }
    }

    return result;
}

void display(struct Node *temp){
    while(temp!=NULL){
        printf("%.0fx^%d",temp->coeff,temp->expo);

        if(temp->link!=NULL)
            printf(" + ");

        temp=temp->link;
    }

    printf("\n");
}
